# Server Configuration
PORT=8080
JWT_SECRET=super-secret-jwt-key-change-in-production

# PostgreSQL Connection String (Transaction Pooler or Direct)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Production Backend
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=

# Maximum 3 Authorized Administrator Emails (Comma-separated)
ADMIN_EMAILS=admin@placiobridge.com,ceo@placiobridge.com,admin3@placiobridge.com
ADMIN_PASSWORD=ChangeMe123!

# CAPTCHA Protection (Configurable provider: Cloudflare Turnstile, hCaptcha, Google reCAPTCHA)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_ENABLED=false

# Email Service API (Resend, SendGrid, Amazon SES, or SMTP)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=notifications@placiobridge.com
CONTACT_RECEIVER_EMAIL=ceo@placiobridge.com

# Core Team API (data.placiobridge.com)
TEAM_API_BASE_URL=https://data.placiobridge.com/api
TEAM_API_KEY=
